---
import { SITE_TITLE } from '../consts';
import InnerHero from '../components/InnerHero.astro';
import MujiangStar from '../components/MujiangStar.astro';
import '../styles/inner-pages.css';
// 可以自行修改，建议只放你愿意公开的信息
const aboutTitle='你好，我是暮江。';
const introduction='喜欢计算机科学，也喜欢那些暂时没有答案的问题。这个博客用来存放学习笔记、阅读后的想法，以及偶尔想记下的生活。';
const interests=['编程','操作系统','阅读','记录生活'];
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="关于暮江的个人博客"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><title>关于我 · {SITE_TITLE}</title></head>
<body class="inner-page"><InnerHero image="/about-bg.jpg" title="关于我" subtitle="================" active="about" />
<main class="page-main">
<section class="intro"><div class="avatar-placeholder" aria-hidden="true"><MujiangStar variant="long" size={86}/><span class="corner-star"><MujiangStar variant="outline" size={25}/></span></div><div><h2>{aboutTitle}</h2><p>{introduction}</p></div></section>
<section class="part"><h2><MujiangStar variant="outline" size={21}/> 一些喜欢的事</h2><div class="chips">{interests.map(interest=><span>{interest}</span>)}</div></section>
<section class="part"><h2><MujiangStar variant="five" size={21}/> 关于这个小站</h2><p>认真整理的内容写在「文章」，轻松的日常留在「说说」。这里不追求固定的更新频率，只希望记录真实的好奇心。</p><div class="actions"><a href="/blog/">阅读文章 ↗</a><a href="/shuoshuo/">看看说说 ↗</a></div></section>
<a class="back-link" href="/">← 返回首页</a></main><footer class="content-footer"><MujiangStar variant="long" size={15}/> 暮江 · {new Date().getFullYear()}</footer></body></html>
<style>
.intro{display:grid;grid-template-columns:180px minmax(0,1fr);align-items:center;gap:38px;padding-bottom:46px;border-bottom:1px solid #e9e3f0}.avatar-placeholder{height:180px;background:linear-gradient(135deg,#f3eaff,#e1d4f8);border-radius:20px;display:grid;place-items:center;position:relative}.corner-star{position:absolute;right:20px;top:19px}.intro h2{font-size:clamp(1.4rem,2.8vw,2rem);margin:0 0 15px}.intro p,.part p{line-height:2;color:#6f687e;margin:0}.part{padding:34px 0;border-bottom:1px solid #e9e3f0}.part h2{display:flex;align-items:center;gap:10px;font-size:1.25rem;margin:0 0 18px}.chips,.actions{display:flex;gap:10px;flex-wrap:wrap}.chips span{border:1px solid #e7dff4;background:white;padding:8px 14px;border-radius:99px;color:#8262c9;font-size:.9rem}.actions{margin-top:22px}.actions a{border:1px solid #e2d5f1;background:white;color:#7958bb;padding:10px 16px;border-radius:8px}.actions a:hover{background:#f4edff}@media(max-width:620px){.intro{grid-template-columns:1fr;gap:24px}.avatar-placeholder{height:145px;width:145px}}
</style>
