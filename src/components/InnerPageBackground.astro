---
/** 三个内页共用的固定背景、正文宽度、顶部留白、标题尺寸和对齐规则。 */
interface Props { image: string }
const { image } = Astro.props;
---
<div class="inner-fixed-bg" style={`--inner-photo: url('${image}')`} aria-hidden="true"></div>
<style is:global>
  /* 真正固定在视口的背景层；页面内容照常滚动。 */
  body.inner-site {
    margin: 0;
    min-height: 100vh;
    background: #201c34;
    color: #28243a;
  }
  .inner-site .inner-fixed-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-color: #241f3a;
    background-image:
      linear-gradient(120deg, rgba(26,20,48,.58), rgba(28,30,54,.35)),
      var(--inner-photo);
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }
  .inner-site > .topbar,
  .inner-site > .main,
  .inner-site > .footer { position: relative; z-index: 1; }
  .inner-site > .topbar { background: rgba(28,23,46,.92); backdrop-filter: blur(12px); }
  /* 同一张半透明内容面板：所有内页从同一列开始排版。 */
  .inner-site > .shell.main {
    width: min(850px, calc(100% - 48px));
    max-width: 850px;
    margin: 64px auto 72px;
    padding: 56px 56px 66px;
    border: 1px solid rgba(255,255,255,.65);
    border-radius: 24px;
    background: rgba(250,249,254,.92);
    box-shadow: 0 16px 70px rgba(17,11,39,.22);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .inner-site .main > .intro,
  .inner-site .main > .eyebrow { margin-top: 0; }
  .inner-site .main .eyebrow { min-height: 23px; margin-bottom: 0; }
  .inner-site .main h1 {
    font-size: clamp(3.4rem,7vw,5.25rem);
    line-height: 1.15;
    margin: 20px 0 16px;
    letter-spacing: -.045em;
  }
  .inner-site .main .lead { margin: 0 0 42px; line-height: 1.8; font-size: 1.08rem; }
  .inner-site .main .search { max-width: none; width: 100%; }
  /* 文章页原来给左侧小星星单独留了一整列，导致文章标题比搜索框右移。
     现在让标题、摘要与搜索框左边缘对齐，把星星当装饰定位在外侧。 */
  .inner-site .main .posts .post {
    position: relative;
    grid-template-columns: minmax(0,1fr) 44px;
    gap: 18px;
    align-items: start;
  }
  .inner-site .main .posts .post .star {
    position: absolute;
    left: -32px;
    top: 32px;
    padding: 0;
  }
  .inner-site .main .posts .post .post-main { min-width: 0; }
  .inner-site .main .posts .post .post-link { grid-column: 2; }
  .inner-site > .footer {
    color: #eee6fa;
    border-color: rgba(255,255,255,.3);
    margin-bottom: 12px;
  }
  @media (max-width: 640px) {
    .inner-site > .shell.main {
      width: calc(100% - 28px);
      margin: 24px auto 40px;
      padding: 33px 24px 42px;
      border-radius: 18px;
    }
    .inner-site .main h1 { font-size: clamp(3rem,13vw,4rem); }
    .inner-site .main .lead { margin-bottom: 30px; }
    .inner-site .main .posts .post { grid-template-columns: minmax(0,1fr) 36px; gap: 8px; }
    .inner-site .main .posts .post .star { display: none; }
    .inner-site .main .posts .post .post-link { grid-column: 2; }
  }
</style>
