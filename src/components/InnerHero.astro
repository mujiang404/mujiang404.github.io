---
import MujiangStar from './MujiangStar.astro';
interface Props { image: string; title: string; subtitle?: string; active: 'blog' | 'shuoshuo' | 'about'; }
const { image, title, subtitle = '', active } = Astro.props;
const navItems = [
  { href: '/', label: '首页', key: 'home' },
  { href: '/blog/', label: '文章', key: 'blog' },
  { href: '/shuoshuo/', label: '说说', key: 'shuoshuo' },
  { href: '/about/', label: '关于', key: 'about' },
];
---
<section class="cover" style={`--cover-image: url('${image}')`} aria-label={`${title}页面封面`}>
  <header class="site-header">
    <nav class="nav-wrap" aria-label="主导航">
      <a class="brand" href="/" aria-label="暮江，返回首页"><MujiangStar variant="long" size={32} /><span>暮江</span></a>
      <div class="nav-links">
        {navItems.map(item => <a href={item.href} aria-current={item.key === active ? 'page' : undefined}>{item.label}</a>)}
        <a href="https://github.com/mujiang404" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </nav>
  </header>
  <div class="cover-center">
    <div class="eyebrow"><MujiangStar variant="eight" size={17} /><span>MUJIANG'S NOTEBOOK</span></div>
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
</section>
<style>
  .cover { height: 58svh; min-height: 340px; max-height: 580px; position: relative; color: #fff; display: flex; flex-direction: column; background-color:#201c35; background-image: linear-gradient(180deg,rgba(20,16,38,.37),rgba(18,17,36,.32) 50%,rgba(18,17,36,.45)),var(--cover-image); background-size:cover; background-position:center center; }
  /* 与首页导航共用相同的宽度、字号、间距和底部细线 */
  .site-header { width: 100%; }
  .nav-wrap { max-width:1180px; width:calc(100% - 80px); margin-inline:auto; min-height:94px; display:flex; align-items:center; justify-content:space-between; gap:24px; border-bottom:1px solid rgba(255,255,255,.2); }
  .brand { display:inline-flex; align-items:center; gap:9px; color:#fff; font-weight:760; font-size:1.45rem; letter-spacing:.02em; text-decoration:none; white-space:nowrap; }
  .brand-dot,.period { color:#b996f5; }
  .nav-links { display:flex; flex-wrap:wrap; gap:clamp(16px,3vw,44px); align-items:center; }
  .nav-links a { color:rgba(245,245,244,.85); text-decoration:none; font-size:.93rem; font-weight:400; transition:color .15s; }
  .nav-links a:hover,.nav-links a[aria-current="page"] { color:#fff; }
  .cover-center { flex:1; width:calc(100% - 48px); max-width:980px; margin:0 auto; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:16px 0 32px; text-shadow:0 2px 16px rgba(0,0,0,.28); }
  .eyebrow { display:flex; align-items:center; gap:9px; font-size:.72rem; font-weight:700; letter-spacing:.18em; color:#eee3ff; }
  h1 { margin:16px 0 12px; font-size:clamp(2.2rem,4vw,3.6rem); line-height:1.15; font-weight:800; letter-spacing:-.04em; }
  p { margin:0; line-height:1.8; font-size:clamp(.92rem,1.25vw,1.08rem); color:#f4f0fb; max-width:620px; }
  @media(max-width:620px) {
    .cover { height:48svh; min-height:330px; }
    .nav-wrap { width:calc(100% - 38px); min-height:80px; flex-wrap:wrap; padding-block:16px; gap:12px; }
    .nav-links { gap:16px; }
    .nav-links a { font-size:.8rem; }
    .cover-center { padding-bottom:20px; }
    .eyebrow { font-size:.62rem; }
  }
</style>
